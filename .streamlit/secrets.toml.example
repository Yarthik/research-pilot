# Streamlit Community Cloud: paste the contents of this file (with your own values) into
#   App -> Settings -> Secrets
# For a local run, copy it to .streamlit/secrets.toml (git-ignored) instead.
#
# Quote every value, including "true"/"false" and numbers. Root-level keys become environment
# variables, which is how researchpilot reads its settings. Keep real keys out of git.

GROQ_API_KEY = "gsk_replace_me"

LLM_PROVIDER = "groq"
LLM_MODEL = "openai/gpt-oss-120b"

# Public demo: fixed documents, a limit per visitor session
AUTO_INGEST_SAMPLES = "true"
ALLOW_INGEST = "false"
DEMO_MAX_QUESTIONS = "5"

# "true": each visitor may add 2 private, temporary files (PDF/TXT/MD, 5 MB, 50 pages) next to the
# shared papers. Needs ALLOW_INGEST = "false". See docs/DEPLOY.md, "Private uploads".
ALLOW_SESSION_UPLOADS = "false"
