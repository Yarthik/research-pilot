# ---------------------------------------------------------------------------
# LLM: switch provider/model here (see README for the full table)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# RETRIEVAL_MODE=hybrid_rerank   # vector | bm25 | hybrid | hybrid_rerank
# FINAL_K=5                      # chunks kept per search query
# MAX_RETRIEVAL_ROUNDS=2         # 1 disables the self-correcting retry
# MAX_EVIDENCE=15                # chunks passed to the answer step

# ---------------------------------------------------------------------------
# Optional web search (free tier at tavily.com)
# ---------------------------------------------------------------------------
# TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Evaluation judge (defaults to the main LLM). A stronger judge model is better.
# ---------------------------------------------------------------------------
# JUDGE_PROVIDER=groq
# JUDGE_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Service / public demo safety
# ---------------------------------------------------------------------------
# API_KEY=change-me              # require X-API-Key on the API
# ALLOW_INGEST=false             # make the corpus read-only on a public demo
# MAX_UPLOAD_MB=20
# AUTO_INGEST_SAMPLES=true       # UI ingests the sample papers on first start

# ---------------------------------------------------------------------------
# Optional tracing (LangSmith), no code changes needed
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=researchpilot
